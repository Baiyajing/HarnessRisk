# Copy to .env and adjust. .env is gitignored.

# --- External harness binaries / checkouts ---
# OpenClaw harness: path to a built OpenClaw checkout (pnpm install && pnpm build).
# Only needed for --harness openclaw.
# OPENCLAW_REPO_ROOT=/path/to/openclaw/openclaw
# HERMES_CMD=hermes
# NANOBOT_CMD=nanobot

# --- Model provider API keys (referenced by name in configs; never committed) ---
# Set whichever your agent/provider uses, e.g.:
# CUSTOM_API_KEY=...
# VOLCANO_ENGINE_API_KEY=...
# AI_WAVE_API_KEY=...

# --- LLM-as-judge (scripts/eval_via_llm) ---
# Reads AIWAVE_API_KEY or OPENAI_API_KEY.
# OPENAI_API_KEY=...
# AIWAVE_BASE_URL=https://api.ai-wave.org/v1
# AIWAVE_MODEL=gpt-5.4
